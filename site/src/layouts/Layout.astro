---
/**
 * Общий каркас страницы: <head> (title, description, favicon, стили),
 * шапка, контент страницы в <main>, полоса госссылок и футер.
 *
 * Шрифт Golos Text подключён локально через @fontsource (self-host):
 * только используемые в дизайне веса 400–800 (900 в CSS не встречается)
 * и только подмножества cyrillic + latin (ext-подмножества не нужны).
 * Google Fonts убран.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GovLinks from '../components/GovLinks.astro';

import '@fontsource/golos-text/cyrillic-400.css';
import '@fontsource/golos-text/latin-400.css';
import '@fontsource/golos-text/cyrillic-500.css';
import '@fontsource/golos-text/latin-500.css';
import '@fontsource/golos-text/cyrillic-600.css';
import '@fontsource/golos-text/latin-600.css';
import '@fontsource/golos-text/cyrillic-700.css';
import '@fontsource/golos-text/latin-700.css';
import '@fontsource/golos-text/cyrillic-800.css';
import '@fontsource/golos-text/latin-800.css';

interface Props {
  /** Заголовок страницы <title> */
  title: string;
  /** Мета-описание страницы */
  description?: string;
  /** Путь активного раздела меню (для подсветки), например '/' */
  active: string;
  /** Показывать иконки в полосе госссылок (главная страница) */
  withGovLinkIcons?: boolean;
}

const { title, description, active, withGovLinkIcons = false } = Astro.props;
---

<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}assets/img/emblem.svg`}>
  <link rel="stylesheet" href={`${import.meta.env.BASE_URL}assets/css/styles.css`}>
</head>
<body>
  <a class="skip-link" href="#main">Перейти к содержанию</a>

  <Header active={active} />

  <main id="main">
    <slot />
  </main>

  <GovLinks withIcons={withGovLinkIcons} />

  <Footer />

  <script src={`${import.meta.env.BASE_URL}assets/js/main.js`} defer></script>
</body>
</html>
