---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';
import AnnouncementIcon from '../components/AnnouncementIcon.astro';
import { getCollection } from 'astro:content';
import { formatDate, isPublished } from '../lib/news';

/** Четыре последние опубликованные новости — свежие сверху (будущие даты скрыты) */
const latestNews = (await getCollection('news'))
  .filter((entry) => isPublished(entry.data.date))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

/** Опубликованные объявления на главной — свежие сверху (блок «Важное для родителей и учеников») */
const announcements = (await getCollection('announcements'))
  .filter((entry) => isPublished(entry.data.date))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const title = 'МБОУ Петрозаводского ГО «СОШ № 29 им. Сепсяковой Т.Ф.» — главная';
const description = 'Официальный сайт средней общеобразовательной школы № 29 имени Сепсяковой Т.Ф. города Петрозаводска: приём в 1 класс, новости, сведения об образовательной организации.';
---

<Layout title={title} description={description} active="/" withGovLinkIcons>
  <!-- HERO -->
  <section class="hero" data-od-id="hero">
    <div class="container">
      <div>
        <p class="hero-eyebrow">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v4m0 0a5 5 0 0 1 5 5h-2a3 3 0 0 0-3-3 3 3 0 0 0-3 3H7a5 5 0 0 1 5-5Z"/><path d="M5 12h14v8H5z"/></svg>
          Качественное образование в Петрозаводске с 1966 года
        </p>
        <h1>Средняя общеобразовательная школа № 29 имени Сепсяковой Т.Ф.</h1>
        <p class="hero-sub">Дружная школьная семья, сильные педагоги и традиции. Опорная школа ОАО «РЖД» — готовим к поступлению в транспортные вузы страны и к жизни в современном мире.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/#priem">Приём в 1 класс</a>
          <a class="btn btn-outline btn-lg" href="/sveden/">Сведения об образовательной организации</a>
        </div>
        <div class="hero-facts">
          <div class="hero-fact"><b>1966</b><span>год основания</span></div>
          <div class="hero-fact"><b>900+</b><span>учеников, 1–11 классы</span></div>
          <div class="hero-fact"><b>57</b><span>педагогических работников</span></div>
          <!-- Плейсхолдер: факты заменить реальными данными школы -->
        </div>
      </div>
      <div class="hero-visual">
        <!-- Абстрактная SVG-иллюстрация: здание школы, книги, ель. Без фото людей. -->
        <svg viewBox="0 0 520 460" role="img" aria-label="Абстрактная иллюстрация: здание школы с елью и книгами" width="520" height="460">
          <circle cx="430" cy="64" r="86" fill="#E4F0ED"/>
          <circle cx="430" cy="64" r="40" fill="#F6EBD7" opacity="0.9"/>
          <rect x="0" y="336" width="520" height="124" rx="28" fill="#EAF1ED"/>
          <rect x="120" y="152" width="280" height="180" rx="10" fill="#FFFFFF" stroke="#D9E0DB" stroke-width="3"/>
          <path d="M108 162 260 88 412 162Z" fill="#0A6B63"/>
          <path d="m250 108 20-6v14l-20 6z" fill="#B47E2E"/>
          <rect x="242" y="150" width="36" height="34" fill="#0A4A45"/>
          <g fill="#BFE0DA">
            <rect x="152" y="200" width="48" height="42" rx="4"/>
            <rect x="216" y="200" width="48" height="42" rx="4"/>
            <rect x="280" y="200" width="48" height="42" rx="4"/>
            <rect x="344" y="200" width="48" height="42" rx="4"/>
            <rect x="152" y="258" width="48" height="42" rx="4"/>
            <rect x="216" y="258" width="48" height="42" rx="4"/>
            <rect x="280" y="258" width="48" height="42" rx="4"/>
            <rect x="344" y="258" width="48" height="42" rx="4"/>
          </g>
          <rect x="248" y="292" width="40" height="40" rx="6" fill="#0A6B63"/>
          <path d="M86 336h92l-10 18H96z" fill="#B47E2E"/>
          <path d="M78 318h104l-10 18H88z" fill="#0A6B63"/>
          <path d="M90 300h84l-8 16H98z" fill="#BFE0DA"/>
          <path d="M466 222 500 292h-68z" fill="#0E7A70"/>
          <path d="M466 262 506 340H426z" fill="#0A6B63"/>
          <rect x="458" y="336" width="16" height="18" rx="3" fill="#8C5A2B"/>
          <circle cx="76" cy="120" r="9" fill="#B47E2E"/>
          <circle cx="470" cy="150" r="7" fill="#0E7A70"/>
          <circle cx="52" cy="240" r="6" fill="#0E7A70"/>
        </svg>
        <div class="hero-badge">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.26 6.85.63-5.15 4.6 1.5 6.71L12 16.8l-6.1 3.4 1.5-6.71L2.25 8.9l6.85-.63z"/></svg>
          Опорная школа ОАО «РЖД»
        </div>
      </div>
    </div>
  </section>

  <!-- ФАКТЫ -->
  <section class="stats-strip" data-od-id="stats">
    <div class="container">
      <div class="stats-list">
        <div class="stat"><b>33</b><span>класс-комплекта</span></div>
        <div class="stat"><b>100%</b><span>учителей с профильным образованием</span></div>
        <div class="stat"><b>12</b><span>кружков и секций</span></div>
        <div class="stat"><b>1</b><span>статус «Опорная школа ОАО „РЖД“»</span></div>
      </div>
    </div>
  </section>

  <!-- ОБЪЯВЛЕНИЯ -->
  <section class="section" data-od-id="announcements">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Объявления</span>
          <h2>Важное для родителей и учеников</h2>
        </div>
        <a class="section-link" href="/news/">Все новости и объявления →</a>
      </div>
      <div class="grid grid-2">
        {announcements.map((entry) => (
          <article
            class={entry.data.important ? 'notice notice-important' : 'notice'}
            data-od-id={`notice-${entry.id}`}
          >
            <div class="notice-icon"><AnnouncementIcon name={entry.data.icon} /></div>
            <div>
              <span class="notice-date">{formatDate(entry.data.date.toISOString().slice(0, 10))}</span>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.excerpt}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- НОВОСТИ -->
  <section class="section section-alt" data-od-id="news">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Новости</span>
          <h2>Жизнь школы</h2>
        </div>
        <a class="section-link" href="/news/">Все новости →</a>
      </div>
      <div class="grid auto-grid">
        {latestNews.map((entry) => (
          <NewsCard news={entry} href={`/news/${entry.id}/`} odId={`news-${entry.id}`} />
        ))}
      </div>
    </div>
  </section>

  <!-- ВИДЖЕТЫ ГОСУСЛУГ -->
  <section class="section" data-od-id="widgets">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Электронные сервисы</span>
          <h2>Госуслуги и открытость</h2>
        </div>
      </div>
      <div class="grid grid-4">
        <div class="widget widget-gosuslugi" data-od-id="widget-pos">
          <div class="widget-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3>«Решаем вместе»</h3>
          <p>Платформа обратной связи с Госуслуг: сообщите о проблеме, задайте вопрос или оцените работу школы.</p>
          <a class="widget-link" href="#">Написать сообщение →</a>
        </div>
        <div class="widget" data-od-id="widget-rating">
          <div class="widget-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.26 6.85.63-5.15 4.6 1.5 6.71L12 16.8l-6.1 3.4 1.5-6.71L2.25 8.9l6.85-.63z"/></svg>
          </div>
          <h3>Независимая оценка качества</h3>
          <div class="stars" aria-label="Рейтинг 4,5 из 5">★★★★<span style="opacity:.35">★</span></div>
          <p>Итоговая оценка на bus.gov.ru — <span class="rating-num">4,5 из 5</span>. Ваше мнение помогает нам становиться лучше.</p>
          <a class="widget-link" href="#">Оставить отзыв на bus.gov.ru →</a>
        </div>
        <div class="widget widget-gosuslugi" data-od-id="widget-first-class">
          <div class="widget-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22c4-4 8-7.3 8-12a8 8 0 1 0-16 0c0 4.7 4 8 8 12z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3>Запись в 1 класс</h3>
          <p>Подайте заявление о приёме в первый класс через портал «Госуслуги» — быстро и без очередей.</p>
          <a class="widget-link" href="#">Подать заявление →</a>
        </div>
        <div class="widget widget-gosuslugi" data-od-id="widget-my-school">
          <div class="widget-icon">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 10v6"/></svg>
          </div>
          <h3>ГИС «Моя школа»</h3>
          <p>Электронный дневник, домашние задания и материалы уроков в единой системе для учеников и родителей.</p>
          <a class="widget-link" href="#">Войти в «Мою школу» →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- БЫСТРЫЕ ССЫЛКИ -->
  <section class="section section-alt" data-od-id="quick-links" id="priem">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="eyebrow">Часто ищут</span>
          <h2>Быстрые ссылки</h2>
        </div>
      </div>
      <div class="quick-links">
        <a class="quick-link" href="#" data-od-id="quick-1class">
          <span class="ql-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15l2 2 4-4"/></svg></span>
          Приём в 1 класс
        </a>
        <a class="quick-link" href="#" data-od-id="quick-gia">
          <span class="ql-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v5l-6 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-9V3"/><path d="M7 14h10"/></svg></span>
          ГИА-9 и ГИА-11
        </a>
        <a class="quick-link" href="#" data-od-id="quick-food">
          <span class="ql-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/></svg></span>
          Организация питания
        </a>
        <a class="quick-link" href="#" data-od-id="quick-diary">
          <span class="ql-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg></span>
          Электронный дневник
        </a>
        <a class="quick-link" href="#" data-od-id="quick-bell">
          <span class="ql-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg></span>
          Расписание звонков
        </a>
        <a class="quick-link" href="/contacts/" data-od-id="quick-contacts">
          <span class="ql-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></span>
          Контакты и обращения
        </a>
      </div>
    </div>
  </section>

  <!-- О ШКОЛЕ TEASER -->
  <section class="section" data-od-id="about-teaser">
    <div class="container">
      <div class="callout" style="margin:0;">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/></svg>
        <div>
          <p style="font-weight:700; color:var(--accent-strong); margin-bottom:.3rem;">Школе 60 лет, но мы молоды душой</p>
          <p>История школы, достижения учеников и педагогов, партнёрство с ОАО «РЖД» и профильные классы — на странице <a href="/o-shkole/">«О школе»</a>.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
