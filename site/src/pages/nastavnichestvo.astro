---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/paths';

const title = 'Наставничество — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Целевая модель наставничества в школе: методические рекомендации Минпросвещения России, положение о наставничестве, «дорожная карта».';
---

<Layout title={title} description={description} active="/nastavnichestvo/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href={url('/')}>Главная</a></li>
        <li><span aria-current="page">Наставничество</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Наставничество</h1>
      <p class="lead">Наставничество в школе реализуется в соответствии с целевой моделью, направленной Минпросвещения России письмом от 23 января 2020 г. № МР-42/02.</p>
    </div>
  </section>

  <div class="layout container">
    <div class="content-block">
      <section id="model" style="scroll-margin-top:110px;">
        <h2>Целевая модель наставничества</h2>
        <p>МИНИСТЕРСТВО ПРОСВЕЩЕНИЯ РОССИЙСКОЙ ФЕДЕРАЦИИ. ПИСЬМО от 23 января 2020 г. № МР-42/02 «О направлении целевой модели наставничества и методических рекомендаций».</p>
        <ul>
          <li>Методические рекомендации по внедрению методологии (целевой модели) наставничества обучающихся для организаций, осуществляющих образовательную деятельность по общеобразовательным, дополнительным общеобразовательным и программам среднего профессионального образования, в том числе с применением лучших практик обмена опытом между обучающимися;</li>
          <li>Положение о наставничестве.</li>
        </ul>
      </section>

      <section id="roadmap" style="scroll-margin-top:110px; margin-top:2.5rem;">
        <h2>«Дорожная карта» наставничества</h2>
        <p>«Дорожная карта» наставничества на 2022–2023 учебный год.</p>
      </section>
    </div>
  </div>
</Layout>
