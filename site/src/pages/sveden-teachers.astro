---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/paths';

const title = 'Педагогический состав — Сведения об ОО — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Педагогический состав школы № 29 имени Сепсяковой Т.Ф.: ФИО педагогов, должности, преподаваемые предметы, квалификационные категории.';

// Строки таблицы — из коллекции teachers; `order` сохраняет порядок исходной разметки
const teachers = (await getCollection('teachers')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title={title} description={description} active="/sveden/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href={url('/')}>Главная</a></li>
        <li><a href={url('/sveden/')}>Сведения об образовательной организации</a></li>
        <li><span aria-current="page">Педагогический состав</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Педагогический состав</h1>
      <p class="lead">Раздел 6 «Сведений об образовательной организации». Сведения о педагогах размещены в соответствии с приказом Рособрнадзора от 04.08.2023 № 1493.</p>
    </div>
  </section>

  <div class="layout container">
    <aside class="side-nav" aria-label="Подразделы сведений об образовательной организации" data-od-id="sveden-sidebar">
      <span class="side-nav-title">Подразделы</span>
      <a href={url('/sveden/')}>01 · Основные сведения</a>
      <a href={url('/sveden/')}>02 · Структура и органы управления</a>
      <a href={url('/sveden/')}>03 · Документы</a>
      <a href={url('/sveden/')}>04 · Образование</a>
      <a href={url('/sveden/')}>05 · Руководство</a>
      <a class="is-active" href={url('/sveden-teachers/')} aria-current="page">06 · Педагогический состав</a>
      <a href={url('/sveden/')}>07 · Материально-техническое обеспечение. Доступная среда</a>
      <a href={url('/sveden/')}>08 · Платные образовательные услуги</a>
      <a href={url('/sveden/')}>09 · Финансово-хозяйственная деятельность</a>
      <a href={url('/sveden/')}>10 · Вакантные места для приёма</a>
      <a href={url('/sveden/')}>11 · Стипендии и меры поддержки</a>
      <a href={url('/sveden/')}>12 · Международное сотрудничество</a>
      <a href={url('/sveden/')}>13 · Организация питания</a>
      <a href={url('/sveden/')}>14 · Образовательные стандарты и требования</a>
    </aside>

    <div class="content-block" data-od-id="sveden-content">
      <h2>Список педагогических работников</h2>
      <p>В школе работают <strong>75 педагогических работников</strong>: 11 — с высшей квалификационной категорией, 8 — с первой, 56 — без квалификационной категории. Ниже — полный списочный состав по уровням общего образования.</p>

      <div class="table-wrap table-teachers">
        <table>
          <caption>Педагогический состав школы</caption>
          <thead>
            <tr>
              <th scope="col">ФИО</th>
              <th scope="col">Должность</th>
              <th scope="col">Преподаваемые учебные предметы</th>
              <th scope="col">Квалификационная категория</th>
              <th scope="col">Образование</th>
            </tr>
          </thead>
          <tbody>
            {
              teachers.map((teacher) => (
                <tr>
                  <td>{teacher.data.name}</td>
                  <td>{teacher.data.position}</td>
                  <td>{teacher.data.subjects}</td>
                  <td>{teacher.data.category}</td>
                  <td>{teacher.data.education}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="table-note">В таблице приведён полный списочный состав педагогических работников школы. Сведения о повышении квалификации и профессиональной переподготовке — в карточках педагогов.</p>

      <h2>Сведения о повышении квалификации</h2>
      <p>Педагоги школы регулярно проходят курсы повышения квалификации по федеральным государственным образовательным стандартам, работе с детьми с ограниченными возможностями здоровья и использованию цифровых образовательных платформ (ГИС «Моя школа», «Сферум»).</p>

      <div class="callout">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M10 3v5l-6 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-9V3"/><path d="M7 14h10"/></svg>
        <p><strong>Сведения о руководителе школы</strong> (директор, заместители директора, график приёма граждан) размещены в подразделе 05 «Руководство».</p>
      </div>
    </div>
  </div>
</Layout>
