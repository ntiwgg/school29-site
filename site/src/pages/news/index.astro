---
import Layout from '../../layouts/Layout.astro';
import NewsCard from '../../components/NewsCard.astro';
import NewsFilters from '../../components/NewsFilters.astro';
import { getCollection } from 'astro:content';
import { isPublished } from '../../lib/news';
import { url } from '../../lib/paths';

/** Все опубликованные новости, свежие сверху (лента на /news/, будущие даты скрыты) */
const news = (await getCollection('news'))
  .filter((entry) => isPublished(entry.data.date))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/** Рубрики для фильтров — уникальные теги опубликованных новостей, по алфавиту */
const tags = [...new Set(news.map((entry) => entry.data.tag))].sort((a, b) => a.localeCompare(b, 'ru'));

const title = 'Новости — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Новости школы № 29 имени Сепсяковой Т.Ф.: события, достижения, объявления и безопасность.';
---

<Layout title={title} description={description} active="/news/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href={url('/')}>Главная</a></li>
        <li><span aria-current="page">Новости</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Новости школы</h1>
      <p class="lead">События, достижения и объявления. Следите за новостями на сайте школы.</p>
    </div>
  </section>

  <section class="section" data-od-id="news-list">
    <div class="container">
      <NewsFilters tags={tags} active={null} />

      <div class="grid auto-grid">
        {news.map((entry) => (
          <NewsCard news={entry} href={url(`/news/${entry.id}/`)} odId={`news-${entry.id}`} heading="h2" />
        ))}
      </div>
    </div>
  </section>
</Layout>
