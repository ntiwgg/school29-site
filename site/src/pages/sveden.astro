---
import Layout from '../layouts/Layout.astro';
import SvedenCard from '../components/SvedenCard.astro';

const title = 'Сведения об образовательной организации — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Сведения об образовательной организации по приказу Рособрнадзора № 1493: основные сведения, документы, образование, педагогический состав, питание и другое.';

const cards = [
  { num: '01', title: 'Основные сведения', description: 'Полное и сокращённое наименование, дата создания, учредитель, место нахождения, режим работы, контактные телефоны и адрес электронной почты.', href: '#' },
  { num: '02', title: 'Структура и органы управления образовательной организацией', description: 'Структурные подразделения, органы управления: управляющий совет, педагогический совет, методические объединения. Положения и регламенты.', href: '#' },
  { num: '03', title: 'Документы', description: 'Устав, лицензия на осуществление образовательной деятельности, свидетельство о государственной аккредитации, локальные нормативные акты, отчёты.', href: '#' },
  { num: '04', title: 'Образование', description: 'Реализуемые уровни образования, формы обучения, нормативные сроки, численность обучающихся, языки образования, учебные планы.', href: '#' },
  { num: '05', title: 'Руководство', description: 'Директор школы и заместители директора: ФИО, должность, контактные телефоны, график приёма граждан.', href: '#' },
  { num: '06', title: 'Педагогический состав', description: 'Сведения о педагогах: ФИО, занимаемая должность, преподаваемые предметы, квалификационная категория, образование.', href: '/sveden-teachers/' },
  { num: '07', title: 'Материально-техническое обеспечение и оснащённость. Доступная среда', description: 'Оборудованные учебные кабинеты, спортивный зал, библиотека, оснащение для детей с ОВЗ и инвалидностью, условия доступности.', href: '#' },
  { num: '08', title: 'Платные образовательные услуги', description: 'Порядок оказания платных образовательных услуг, стоимость, договоры, документы об утверждении стоимости обучения.', href: '#' },
  { num: '09', title: 'Финансово-хозяйственная деятельность', description: 'Объём образовательной деятельности, финансовое обеспечение, поступления и расходы, отчёт о результатах самообследования.', href: '#' },
  { num: '10', title: 'Вакантные места для приёма (перевода) обучающихся', description: 'Количество свободных мест в классах по каждой образовательной программе, условия приёма и перевода.', href: '#' },
  { num: '11', title: 'Стипендии и меры поддержки обучающихся', description: 'Меры социальной поддержки, льготное питание, материальная помощь, стипендиальные программы.', href: '#' },
  { num: '12', title: 'Международное сотрудничество', description: 'Заключённые и планируемые договоры с иностранными и международными организациями, формы сотрудничества.', href: '#' },
  { num: '13', title: 'Организация питания', description: 'Меню, режим питания, условия для обучающихся с ОВЗ, контакты ответственных, горячая линия по вопросам питания.', href: '#' },
  { num: '14', title: 'Образовательные стандарты и требования', description: 'Реализуемые ФГОС начального, основного и среднего общего образования, федеральные основные общеобразовательные программы.', href: '#' },
];
---

<Layout title={title} description={description} active="/sveden/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href="/">Главная</a></li>
        <li><span aria-current="page">Сведения об образовательной организации</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Сведения об образовательной организации</h1>
      <p class="lead">Информация размещена на официальном сайте в соответствии с требованиями к структуре официального сайта образовательной организации, утверждёнными приказом Рособрнадзора от 04.08.2023 № 1493.</p>
    </div>
  </section>

  <section class="section" data-od-id="sveden-sections">
    <div class="container">
      <div class="grid grid-2">
        {
          cards.map((card, index) => (
            <SvedenCard
              odId={`sveden-${index + 1}`}
              num={card.num}
              title={card.title}
              description={card.description}
              href={card.href}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
