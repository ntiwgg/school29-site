---
import Layout from '../layouts/Layout.astro';
import SvedenCard from '../components/SvedenCard.astro';
import { getCollection } from 'astro:content';

const title = 'Сведения об образовательной организации — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Сведения об образовательной организации по приказу Рособрнадзора № 1493: основные сведения, документы, образование, педагогический состав, питание и другое.';

/** 14 подразделов по приказу № 1493, в порядке поля num */
const sections = (await getCollection('sveden')).sort((a, b) => a.data.num - b.data.num);

/**
 * Ссылка на подраздел: «Педагогический состав» живёт на отдельной странице
 * /sveden-teachers/, остальные подразделы — на /sveden/<slug>/.
 */
function sectionHref(slug: string): string {
  return slug === 'pedagogicheskiy-sostav' ? '/sveden-teachers/' : `/sveden/${slug}/`;
}
---

<Layout title={title} description={description} active="/sveden/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href="/">Главная</a></li>
        <li><span aria-current="page">Сведения об образовательной организации</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Сведения об образовательной организации</h1>
      <p class="lead">Информация размещена на официальном сайте в соответствии с требованиями к структуре официального сайта образовательной организации, утверждёнными приказом Рособрнадзора от 04.08.2023 № 1493.</p>
    </div>
  </section>

  <section class="section" data-od-id="sveden-sections">
    <div class="container">
      <div class="grid grid-2">
        {
          sections.map((entry, index) => (
            <SvedenCard
              odId={`sveden-${index + 1}`}
              num={String(entry.data.num).padStart(2, '0')}
              title={entry.data.title}
              description={entry.data.description}
              href={sectionHref(entry.id)}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
