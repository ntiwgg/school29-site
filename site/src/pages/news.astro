---
import Layout from '../layouts/Layout.astro';
import NewsCard from '../components/NewsCard.astro';

const title = 'Новости — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Новости школы № 29 имени Сепсяковой Т.Ф.: события, достижения, объявления и безопасность.';
---

<Layout title={title} description={description} active="/news/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href="/">Главная</a></li>
        <li><span aria-current="page">Новости</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Новости школы</h1>
      <p class="lead">События, достижения и объявления. Актуальные новости также публикуются в официальной группе школы ВКонтакте — нашем госпаблике.</p>
    </div>
  </section>

  <section class="section" data-od-id="news-list">
    <div class="container">
      <!-- Фильтр для прототипа: переключатели без JS, активная рубрика помечена -->
      <div class="news-filters" role="group" aria-label="Рубрики новостей">
        <a class="filter-chip is-active" href="#" aria-current="true">Все</a>
        <a class="filter-chip" href="#">События</a>
        <a class="filter-chip" href="#">Достижения</a>
        <a class="filter-chip" href="#">Объявления</a>
        <a class="filter-chip" href="#">Спорт</a>
        <a class="filter-chip" href="#">Безопасность</a>
      </div>

      <div class="grid auto-grid">
        <NewsCard odId="news-2026-08-27" datetime="2026-08-27" date="27 августа 2026" tagClass="tag tag-event" tag="События" href="#" title="Школа готова к новому учебному году: итоги приёмки" text="Комиссия проверила готовность кабинетов, спортивного зала и столовой. Проведён косметический ремонт коридоров и обновлена материально-техническая база.">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><path d="M12 2v4m0 0a5 5 0 0 1 5 5h-2a3 3 0 0 0-3-3 3 3 0 0 0-3 3H7a5 5 0 0 1 5-5Z"/><path d="M5 12h14v8H5z"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-08-21" datetime="2026-08-21" date="21 августа 2026" tagClass="tag tag-announce" tag="Приём" href="#" title="Наши выпускники стали студентами транспортных вузов" text="11 выпускников поступили в РУТ (МИИТ) и ПГУПС, ещё 14 — в вузы Петрозаводска и Санкт-Петербурга. Поздравляем ребят и родителей!">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 10v6"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-08-14" datetime="2026-08-14" date="14 августа 2026" tagClass="tag tag-achiev" tag="Достижения" href="#" title="Учитель школы № 29 — лауреат конкурса «Учитель года Карелии»" text="Учитель начальных классов Фёдорова И.В. вошла в число пяти лауреатов республиканского этапа и представит Карелию на всероссийском уровне.">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><circle cx="12" cy="8" r="6"/><path d="M15.5 13 17 22l-5-3-5 3 1.5-9"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-08-06" datetime="2026-08-06" date="6 августа 2026" tagClass="tag tag-event" tag="События" href="#" title="Летняя трудовая практика: приводим в порядок пришкольную территорию" text="Старшеклассники ухаживали за цветниками и спортивной площадкой. Благодарим ребят за помощь школе!">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-07-28" datetime="2026-07-28" date="28 июля 2026" tagClass="tag tag-event" tag="Спорт" href="#" title="Школьный спортивный клуб: итоги летнего сезона" text="Команды школы по баскетболу и лёгкой атлетике заняли призовые места на городских соревнованиях. Ждём новичков в сентябре!">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-07-15" datetime="2026-07-15" date="15 июля 2026" tagClass="tag tag-event" tag="События" href="#" title="Профильная смена «Юный железнодорожник»" text="Ученики профильных классов школы прошли летнюю практику на базе Детской железной дороги Петрозаводска в рамках партнёрства с ОАО «РЖД».">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-07-01" datetime="2026-07-01" date="1 июля 2026" tagClass="tag tag-announce" tag="Объявления" href="#" title="Опубликовано расписание ГИА дополнительного периода" text="Расписание экзаменов сентября 2026 года для выпускников 9-х и 11-х классов — в разделе «Ученикам» и на информационных стендах школы.">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><path d="M9 3h6M10 3v5l-6 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-9V3"/><path d="M7 14h10"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-06-20" datetime="2026-06-20" date="20 июня 2026" tagClass="tag tag-event" tag="События" href="#" title="Выпускной-2026: аттестаты вручены!" text="В этом году школу окончили 74 одиннадцатиклассника. 9 медалистов «За особые успехи в учении» — гордость школы. В добрый путь, выпускники!">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/></svg>
        </NewsCard>
        <NewsCard odId="news-2026-06-05" datetime="2026-06-05" date="5 июня 2026" tagClass="tag tag-safe" tag="Безопасность" href="#" title="Безопасное лето: памятки для родителей" text="Правила поведения на воде, в лесу и на дороге. Памятки доступны в разделе «Безопасность», а также в бумажном виде у классных руководителей.">
          <svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" slot="cover"><path d="M12 22c4-4 8-7.3 8-12a8 8 0 1 0-16 0c0 4.7 4 8 8 12z"/><circle cx="12" cy="10" r="3"/></svg>
        </NewsCard>
      </div>

      <nav class="pagination" aria-label="Страницы новостей">
        <span class="is-current" aria-current="page">1</span>
        <a href="#">2</a>
        <a href="#">3</a>
        <a href="#">4</a>
        <span class="page-ellipsis" aria-hidden="true">…</span>
        <a href="#">12</a>
        <a href="#" aria-label="Следующая страница">→</a>
      </nav>
    </div>
  </section>
</Layout>
