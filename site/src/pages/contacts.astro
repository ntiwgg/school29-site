---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { url } from '../lib/paths';

const title = 'Контакты — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Контакты школы № 29 имени Сепсяковой Т.Ф.: адрес, телефоны, электронная почта, режим работы, порядок обращений граждан.';

/**
 * Единая запись коллекции contacts (src/content/contacts.md) —
 * адрес, телефоны, e-mail, режим работы и реквизиты редактируются через Decap.
 */
const contact = await getEntry('contacts', 'contacts');
if (!contact) {
  throw new Error('Коллекция contacts пуста: заполните src/content/contacts.md');
}
const { address, phones, email, workhours, requisites } = contact.data;

/** Строка «Метка: значение» → { label, value } (разделитель — первое «: ») */
function splitLabelValue(line: string): { label: string; value: string } {
  const separator = line.indexOf(': ');
  if (separator === -1) return { label: line, value: '' };
  return { label: line.slice(0, separator), value: line.slice(separator + 2) };
}

/** «+7 (8142) 33-20-29» → tel:+78142332029 (только цифры) */
function telHref(phone: string): string {
  return `tel:+${phone.replace(/\D/g, '')}`;
}
---

<Layout title={title} description={description} active="/contacts/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href={url('/')}>Главная</a></li>
        <li><span aria-current="page">Контакты</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Контакты</h1>
      <p class="lead">Адрес, телефоны, режим работы школы и порядок обращений граждан.</p>
    </div>
  </section>

  <div class="layout container">
    <aside class="side-nav" aria-label="Навигация по странице" data-od-id="contacts-sidebar">
      <span class="side-nav-title">На странице</span>
      <a href="#contacts-info">Адрес и телефоны</a>
      <a href="#map">Как добраться</a>
      <a href="#requisites">Реквизиты</a>
      <a href="#appeal-form">Обращения граждан</a>
    </aside>

    <div class="content-block">
      <section id="contacts-info" class="grid grid-2" data-od-id="contacts-info" aria-label="Контактная информация" style="margin-bottom:1.5rem;">
        <div class="contact-block">
          <h2>Адрес</h2>
          <ul>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>{address}</span>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
              <a href={`mailto:${email}`}>{email}</a>
            </li>
            <li>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              <span>{workhours}</span>
            </li>
          </ul>
        </div>
        <div class="contact-block">
          <h2>Телефоны</h2>
          <ul>
            {
              phones.map((phone) => {
                const { label, value } = splitLabelValue(phone);
                return (
                  <li>
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span>{label}: <a href={telHref(value)}>{value}</a></span>
                  </li>
                );
              })
            }
          </ul>
        </div>
      </section>

      <!-- КАРТА-ЗАГЛУШКА -->
      <h2 id="map" style="scroll-margin-top:110px;">Как нас найти</h2>
      <!-- Плейсхолдер: заменить на интерактивную карту (Яндекс Карты / 2ГИС) при вёрстке -->
      <div class="map-ph" data-od-id="map" role="img" aria-label="Схема проезда: школа находится на набережной Варкауса, 5">
        <svg viewBox="0 0 800 340" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <rect width="800" height="340" fill="#EAF1ED"/>
          <g stroke="#C9D6D0" stroke-width="10" fill="none">
            <path d="M0 96 H800"/>
            <path d="M0 210 H800"/>
            <path d="M160 0 V340"/>
            <path d="M420 0 V340"/>
            <path d="M640 0 V340"/>
          </g>
          <g fill="#B9CBC4">
            <rect x="40" y="140" width="90" height="40" rx="6"/>
            <rect x="470" y="60" width="90" height="40" rx="6"/>
            <rect x="470" y="150" width="90" height="40" rx="6"/>
            <rect x="690" y="150" width="70" height="40" rx="6"/>
          </g>
          <rect x="250" y="120" width="130" height="70" rx="10" fill="#FFFFFF" stroke="#0A6B63" stroke-width="3"/>
          <path d="M250 130 L315 96 L380 130 Z" fill="#0A6B63"/>
          <rect x="300" y="150" width="28" height="40" fill="#0A6B63"/>
          <circle cx="315" cy="155" r="14" fill="#B47E2E"/>
          <path d="M315 145 v20 M305 155 h20" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round"/>
        </svg>
        <div class="map-label">
          <b>СОШ № 29 им. Сепсяковой Т.Ф.</b>
          наб. Варкауса, 5
        </div>
      </div>

      <!-- РЕКВИЗИТЫ -->
      <h2 id="requisites" style="scroll-margin-top:110px; margin-top:2rem;">Реквизиты</h2>
      <div class="table-wrap table-requisites">
        <table>
          <caption>Реквизиты учреждения</caption>
          <tbody>
            {
              requisites.map((row) => {
                const { label, value } = splitLabelValue(row);
                return (
                  <tr><th scope="row">{label}</th><td>{value}</td></tr>
                );
              })
            }
          </tbody>
        </table>
      </div>

      <!-- ОБРАЩЕНИЯ ГРАЖДАН -->
      <h2 id="appeal-form" style="scroll-margin-top:110px; margin-top:2rem;">Обращения граждан</h2>
      <p>Официальные обращения, направленные в порядке, установленном Федеральным законом от 02.05.2006 № 59-ФЗ «О порядке рассмотрения обращений граждан Российской Федерации», принимаются:</p>
      <ul>
        <li>через платформу «Решаем вместе» на портале Госуслуг: <a href="https://pos.gosuslugi.ru/form/" target="_blank" rel="noopener">pos.gosuslugi.ru/form/</a>;</li>
        <li>по электронной почте: <a href={`mailto:${email}`}>{email}</a>;</li>
        <li>на личном приёме по адресу: {address} — график работы: {workhours}.</li>
      </ul>
    </div>
  </div>
</Layout>
