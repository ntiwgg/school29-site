        <!-- ФОРМА ОБРАЩЕНИЙ -->
        <h2 id="appeal-form" style="scroll-margin-top:110px; margin-top:2rem;">Обращения граждан</h2>
        <p>Заполните форму — ответ будет направлен на указанный адрес электронной почты. Сообщение о персональных данных не публикуются.</p>
        <form class="form" action="#" method="post" data-od-id="appeal-form">
          <div class="form-grid">
            <div>
              <label for="f-name">Фамилия, имя, отчество <span class="req" aria-hidden="true">*</span></label>
              <input id="f-name" name="name" type="text" required autocomplete="name">
            </div>
            <div>
              <label for="f-email">Электронная почта <span class="req" aria-hidden="true">*</span></label>
              <input id="f-email" name="email" type="email" required autocomplete="email">
            </div>
            <div>
              <label for="f-phone">Телефон</label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel">
            </div>
            <div>
              <label for="f-topic">Тема обращения</label>
              <select id="f-topic" name="topic">
                <option value="general">Общие вопросы</option>
                <option value="admission">Приём в школу</option>
                <option value="gia">Государственная итоговая аттестация</option>
                <option value="food">Организация питания</option>
                <option value="security">Информационная безопасность</option>
                <option value="other">Другое</option>
              </select>
            </div>
          </div>
          <div>
            <label for="f-text">Текст обращения <span class="req" aria-hidden="true">*</span></label>
            <textarea id="f-text" name="text" required placeholder="Опишите ваш вопрос. Старайтесь указывать класс ребёнка, если вопрос касается учёбы."></textarea>
          </div>
          <div class="consent">
            <input id="f-consent" name="consent" type="checkbox" required>
            <label for="f-consent">Я даю <a href="#">согласие на обработку персональных данных</a> в соответствии с Федеральным законом от 27.07.2006 № 152-ФЗ <span class="req" aria-hidden="true">*</span></label>
          </div>
          <div>
            <button class="btn btn-primary btn-lg" type="submit">Отправить обращение</button>
            <p class="hint" style="margin-top:.6rem;">Поля, отмеченные <span class="req">*</span>, обязательны для заполнения.</p>
