---
import Layout from '../../layouts/Layout.astro';
import SvedenCard from '../../components/SvedenCard.astro';
import { url } from '../../lib/paths';

const title = 'Ученикам — СОШ № 29 им. Сепсяковой Т.Ф.';
const description = 'Информация для обучающихся: государственная итоговая аттестация, одарённые дети, школьный спортивный клуб, наставничество, социально-психологическое тестирование, отдых и оздоровление.';

const sections = [
  {
    num: '01',
    title: 'Государственная итоговая аттестация (ГИА)',
    description: 'ГИА-9 и ГИА-11: допуск, регистрация, итоговое собеседование и итоговое сочинение, полезные ссылки.',
    href: '/gia/',
  },
  {
    num: '02',
    title: 'Одарённые дети',
    description: 'Всероссийская олимпиада школьников, конкурс «Эврикоша», достижения обучающихся.',
    href: '/students/odarennye-deti/',
  },
  {
    num: '03',
    title: 'Школьный спортивный клуб',
    description: 'Школьный спортивный клуб «Факел»: положение, планы работы, расписание спортивных секций.',
    href: '/students/sportklub/',
  },
  {
    num: '04',
    title: 'Наставничество',
    description: 'Целевая модель наставничества: методические рекомендации, положение, «дорожная карта».',
    href: '/nastavnichestvo/',
  },
  {
    num: '05',
    title: 'Социально-психологическое тестирование (СПТ)',
    description: 'Порядок проведения СПТ, единая методика, контакты ответственных, профилактические медицинские осмотры.',
    href: '/students/spt/',
  },
  {
    num: '06',
    title: 'Отдых и оздоровление детей',
    description: 'Информация об организации отдыха детей и их оздоровления.',
    href: '/students/otdyh-detej/',
  },
];
---

<Layout title={title} description={description} active="/students/">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Хлебные крошки" data-od-id="breadcrumbs">
      <ol>
        <li><a href={url('/')}>Главная</a></li>
        <li><span aria-current="page">Ученикам</span></li>
      </ol>
    </nav>
  </div>

  <section class="page-hero" data-od-id="page-hero">
    <div class="container">
      <h1>Ученикам</h1>
      <p class="lead">Раздел для обучающихся: экзамены, олимпиады, спорт, наставничество, тестирование и организация отдыха.</p>
    </div>
  </section>

  <section class="section" data-od-id="students-sections">
    <div class="container">
      <div class="grid grid-2">
        {
          sections.map((section, index) => (
            <SvedenCard
              odId={`students-${index + 1}`}
              num={section.num}
              title={section.title}
              description={section.description}
              href={url(section.href)}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
