---
import { url } from '../lib/paths';

/**
 * Шапка сайта: топбар с контактами, логотип, поиск, главное меню.
 * Разметка перенесена 1:1 из исходных страниц; отличается только
 * активный пункт меню — определяется пропсом `active`.
 */
interface Props {
  /** Путь активного раздела, например '/' или '/o-shkole/' */
  active: string;
}

const { active } = Astro.props;

const isActive = (href: string) => active === href;

/**
 * Активность кнопки-дропдауна: подсвечивается, если текущая страница
 * принадлежит разделу. «ГИА» и «Наставничество» — общие разделы,
 * поэтому подсвечиваются в обоих связанных меню.
 */
const sectionActive = (href: string): boolean => {
  if (href === '/parents/') return active === href || active === '/gia/';
  if (href === '/students/') return active === href || active === '/gia/' || active === '/nastavnichestvo/';
  if (href === '/teachers/') return active === href || active === '/nastavnichestvo/';
  return active === href;
};
---

<header class="site-header" data-od-id="site-header">
  <div class="header-top">
    <div class="container">
      <div class="header-contacts">
        <a href="tel:+78142780029" aria-label="Позвонить в школу: +7 (8142) 78-00-29">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          +7 (8142) 78-00-29
        </a>
        <a href="mailto:school29@petrozavodsk-edu.ru" aria-label="Написать на почту: school29@petrozavodsk-edu.ru">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
          school29@petrozavodsk-edu.ru
        </a>
        <span class="hide-sm">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Пн–Пт 08:00–19:00
        </span>
      </div>
      <div class="header-tools">
        <button class="eye-btn" type="button">Версия для слабовидящих</button>
      </div>
    </div>
  </div>

  <div class="header-main">
    <div class="container">
      <a class="brand" href={url('/')}>
        <img class="brand-logo" src={`${import.meta.env.BASE_URL}assets/img/emblem.svg`} alt="Эмблема школы № 29 имени Сепсяковой Т.Ф." width="62" height="72">
        <span>
          <span class="brand-title">МБОУ Петрозаводского ГО «СОШ № 29 им. Сепсяковой Т.Ф.»</span>
          <span class="brand-sub">Средняя общеобразовательная школа · Петрозаводск</span>
        </span>
      </a>
      <div class="header-actions">
        <form class="search-form" role="search" action="#" method="get">
          <label class="visually-hidden" for="site-search">Поиск по сайту</label>
          <input id="site-search" type="search" name="q" placeholder="Поиск по сайту" autocomplete="off">
          <button class="search-btn" type="submit" aria-label="Найти">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          </button>
        </form>
        <button class="burger" type="button" aria-expanded="false" aria-controls="main-nav" aria-label="Открыть меню">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <nav class="main-nav" id="main-nav" aria-label="Главное меню">
    <div class="container">
      <ul class="nav-list">
        <li class="nav-item"><a class:list={['nav-link', { 'is-active': isActive('/') }]} href={url('/')} aria-current={isActive('/') ? 'page' : undefined}>Главная</a></li>
        <li class="nav-item">
          <a class:list={['nav-link', { 'is-active': isActive('/o-shkole/') }]} href={url('/o-shkole/')} aria-current={isActive('/o-shkole/') ? 'page' : undefined}>О школе</a>
          <ul class="submenu">
            <li><a href={url('/o-shkole/#history')}>История школы</a></li>
            <li><a href={url('/o-shkole/#achievements')}>Достижения</a></li>
            <li><a href={url('/o-shkole/#rzd')}>Опорная школа ОАО «РЖД»</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a class:list={['nav-link', { 'is-active': isActive('/sveden/') }]} href={url('/sveden/')} aria-current={isActive('/sveden/') ? 'page' : undefined}>Сведения об ОО</a>
          <ul class="submenu">
            <li><a href={url('/sveden/')}>Все 14 подразделов</a></li>
            <li><a href={url('/sveden-teachers/')}>Педагогический состав</a></li>
            <li><a href={url('/sveden/dokumenty/')}>Документы</a></li>
            <li><a href={url('/sveden/platnye-obrazovatelnye-uslugi/')}>Платные образовательные услуги</a></li>
            <li><a href={url('/sveden/organizaciya-pitaniya/')}>Организация питания</a></li>
          </ul>
        </li>
        <li class="nav-item"><a class:list={['nav-link', { 'is-active': isActive('/news/') }]} href={url('/news/')} aria-current={isActive('/news/') ? 'page' : undefined}>Новости</a></li>
        <li class="nav-item">
          <button class:list={['nav-toggle', { 'is-active': sectionActive('/parents/') }]} type="button" aria-expanded="false" aria-haspopup="true">Родителям <span class="caret" aria-hidden="true"></span></button>
          <ul class="submenu">
            <li><a href={url('/parents/')}>Все разделы</a></li>
            <li><a href={url('/parents/priem-1-klass/')}>Приём в 1 класс</a></li>
            <li><a href={url('/parents/priem-10-klass/')}>Приём в 10 класс</a></li>
            <li><a href={url('/gia/')}>Государственная итоговая аттестация (ГИА)</a></li>
            <li><a href={url('/sveden/organizaciya-pitaniya/')}>Организация питания</a></li>
            <li><a href={url('/parents/faq/')}>Частые вопросы</a></li>
            <li><a href={url('/parents/malyshok/')}>Школа «Малышок»</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <button class:list={['nav-toggle', { 'is-active': sectionActive('/students/') }]} type="button" aria-expanded="false" aria-haspopup="true">Ученикам <span class="caret" aria-hidden="true"></span></button>
          <ul class="submenu">
            <li><a href={url('/students/')}>Все разделы</a></li>
            <li><a href={url('/gia/')}>Государственная итоговая аттестация (ГИА)</a></li>
            <li><a href={url('/students/odarennye-deti/')}>Одарённые дети</a></li>
            <li><a href={url('/students/sportklub/')}>Школьный спортивный клуб</a></li>
            <li><a href={url('/nastavnichestvo/')}>Наставничество</a></li>
            <li><a href={url('/students/spt/')}>Социально-психологическое тестирование (СПТ)</a></li>
            <li><a href={url('/students/otdyh-detej/')}>Отдых и оздоровление детей</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <button class:list={['nav-toggle', { 'is-active': sectionActive('/teachers/') }]} type="button" aria-expanded="false" aria-haspopup="true">Педагогам <span class="caret" aria-hidden="true"></span></button>
          <ul class="submenu">
            <li><a href={url('/teachers/')}>Все разделы</a></li>
            <li><a href={url('/nastavnichestvo/')}>Наставничество</a></li>
            <li><a href={url('/teachers/nagruzka/')}>Снижение бюрократической нагрузки</a></li>
            <li><a href={url('/sveden/dokumenty/')}>Документы</a></li>
          </ul>
        </li>
        <li class="nav-item">
          <a class:list={['nav-link', { 'is-active': isActive('/bezopasnost/') }]} href={url('/bezopasnost/')} aria-current={isActive('/bezopasnost/') ? 'page' : undefined}>Безопасность</a>
          <ul class="submenu">
            <li><a href={url('/bezopasnost/#antiterror')}>Антитеррористическая защищённость</a></li>
            <li><a href={url('/bezopasnost/#road')}>Дорожная безопасность</a></li>
            <li><a href={url('/bezopasnost/#fire')}>Пожарная безопасность</a></li>
            <li><a href={url('/bezopasnost/#info')}>Информационная безопасность</a></li>
          </ul>
        </li>
        <li class="nav-item"><a class:list={['nav-link', { 'is-active': isActive('/contacts/') }]} href={url('/contacts/')} aria-current={isActive('/contacts/') ? 'page' : undefined}>Контакты</a></li>
      </ul>
    </div>
  </nav>
</header>
