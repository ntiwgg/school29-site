---
/**
 * Справочник SVG-иконок обложек новостей.
 * Внутренняя разметка иконок перенесена 1:1 из карточек прототипа,
 * поэтому визуал карточек не меняется. Новые иконки добавляются сюда
 * и в список `cover` в src/content.config.ts + в select Decap (config.yml).
 */
const icons: Record<string, string> = {
  /** Громкоговоритель — «Школа готова к новому учебному году» */
  megaphone: '<path d="M12 2v4m0 0a5 5 0 0 1 5 5h-2a3 3 0 0 0-3-3 3 3 0 0 0-3 3H7a5 5 0 0 1 5-5Z"/><path d="M5 12h14v8H5z"/>',
  /** Шапка выпускника с кисточкой — поступление в вузы */
  graduation: '<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/><path d="M22 10v6"/>',
  /** Медаль — победы и достижения */
  award: '<circle cx="12" cy="8" r="6"/><path d="M15.5 13 17 22l-5-3-5 3 1.5-9"/>',
  /** Солнце — летние события */
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>',
  /** Часы — спорт и расписания */
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  /** Поезд — «Юный железнодорожник», РЖД */
  train: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>',
  /** Колба — ГИА и экзамены */
  flask: '<path d="M9 3h6M10 3v5l-6 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-9V3"/><path d="M7 14h10"/>',
  /** Шапка выпускника — выпускной */
  diploma: '<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5"/>',
  /** Щит — безопасность */
  shield: '<path d="M12 22c4-4 8-7.3 8-12a8 8 0 1 0-16 0c0 4.7 4 8 8 12z"/><circle cx="12" cy="10" r="3"/>',
};

interface Props {
  /** Имя иконки из справочника (ключ записи в `icons`) */
  name: string;
}

const { name } = Astro.props;
const inner = icons[name] ?? icons.megaphone;
---

<svg viewBox="0 0 24 24" width="34" height="34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={inner} />
