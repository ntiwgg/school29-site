---
import { url } from '../lib/paths';

/**
 * Футер сайта: контакты, разделы, документы, приём в школу.
 * Разметка перенесена 1:1 из исходных страниц (идентична на всех 7 страницах).
 */
---

<footer class="site-footer" data-od-id="site-footer">
  <div class="footer-main">
    <div class="container">
      <div class="footer-col">
        <div class="footer-brand">
          <img src={`${import.meta.env.BASE_URL}assets/img/emblem.svg`} alt="" width="48" height="56">
          <div>
            <h3>МБОУ Петрозаводского ГО «СОШ № 29 им. Сепсяковой Т.Ф.»</h3>
            <p>185031, Республика Карелия, г. Петрозаводск, ул. Лыжная, д. 4</p>
          </div>
        </div>
        <ul>
          <li><a href="tel:+78142780029">+7 (8142) 78-00-29 — приёмная</a></li>
          <li><a href="mailto:school29@petrozavodsk-edu.ru">school29@petrozavodsk-edu.ru</a></li>
          <li>Пн–Пт 08:00–19:00, Сб 08:00–15:00</li>
        </ul>
        <div class="footer-socials">
          <a href="#" aria-label="ВКонтакте">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.684 0H8.316C1.592 0 0 1.592 0 8.316v7.368C0 22.408 1.592 24 8.316 24h7.368C22.408 24 24 22.408 24 15.684V8.316C24 1.592 22.408 0 15.684 0zm3.692 17.123h-1.744c-.66 0-.864-.525-2.05-1.727-1.033-1-1.49-1.135-1.744-1.135-.356 0-.458.102-.458.593v1.575c0 .424-.135.678-1.253.678-1.846 0-3.896-1.118-5.335-3.202C4.624 10.857 4.03 8.57 4.03 8.096c0-.254.102-.49.593-.49h1.744c.44 0 .61.203.78.677.847 2.46 2.273 4.607 2.86 4.607.22 0 .322-.102.322-.66V9.721c-.07-1.186-.695-1.287-.695-1.71 0-.204.17-.407.44-.407h2.744c.373 0 .508.203.508.643v3.473c0 .372.17.508.44.508.356 0 .66-.136 1.321-.796 1.32-1.473 2.256-3.745 2.256-3.745.12-.254.322-.49.762-.49h1.744c.525 0 .643.271.525.643-.22 1.017-2.41 4.168-2.41 4.168-.19.305-.254.44 0 .78.186.254.796.779 1.202 1.253.762.848 1.355 1.557 1.51 2.05.17.49-.085.745-.61.745z"/></svg>
          </a>
          <a href="#" aria-label="Телеграм">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </a>
          <a href="#" aria-label="Одноклассники">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="7" r="4.2"/><path d="M12 12.5c-3 0-5.6 1.6-6.9 4 .4.9 1.3 1.5 2.3 1.6 1.4 1.7 3.7 2.9 4.6 3.4.9-.5 3.2-1.7 4.6-3.4 1-.1 1.9-.7 2.3-1.6-1.3-2.4-3.9-4-6.9-4z"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-col">
        <h3>Разделы</h3>
        <ul>
          <li><a href={url('/sveden/')}>Сведения об образовательной организации</a></li>
          <li><a href={url('/news/')}>Новости</a></li>
          <li><a href={url('/o-shkole/')}>О школе</a></li>
          <li><a href={url('/bezopasnost/')}>Безопасность</a></li>
          <li><a href={url('/contacts/')}>Контакты</a></li>
          <li><a href="#">Карта сайта</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Документы и политика</h3>
        <ul>
          <li><a href="#">Политика обработки персональных данных</a></li>
          <li><a href="#">Противодействие коррупции</a></li>
          <li><a href="#">Независимая оценка качества условий осуществления образовательной деятельности</a></li>
          <li><a href="#">Отчёт о результатах самообследования</a></li>
          <li><a href="#">Предписания органов надзора</a></li>
        </ul>
      </div>
      <div class="footer-col">
        <h3>Приём в школу</h3>
        <ul>
          <li><a href="#">Приём в 1 класс</a></li>
          <li><a href="#">Приём в 10 класс</a></li>
          <li><a href="#">Государственная итоговая аттестация</a></li>
          <li><a href="#">Школа «Малышок»</a></li>
          <li><a href="#">Горячая линия по питанию: +7 (8142) 78-00-33</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-legal">
    <div class="container">
      <span>© 2026 МБОУ Петрозаводского ГО «СОШ № 29 им. Сепсяковой Т.Ф.»</span>
      <span>Официальные страницы в соцсетях являются госпабликами · 6+</span>
    </div>
  </div>
</footer>
