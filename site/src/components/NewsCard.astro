---
/**
 * Карточка новости: обложка-иконка, дата, рубрика, заголовок, анонс, ссылка.
 * Разметка идентична на главной и на странице «Новости».
 * Данные берутся из коллекции контента `news` (src/content/news).
 */
import type { CollectionEntry } from 'astro:content';
import NewsIcon from './NewsIcon.astro';
import { TAG_CLASS_MAP, formatDate } from '../lib/news';

interface Props {
  /** Запись новости из коллекции `news` */
  news: CollectionEntry<'news'>;
  /** Ссылка карточки (заголовок и «Читать далее») */
  href: string;
  /** Идентификатор для дизайн-системы OpenDesign */
  odId: string;
}

const { news, href, odId } = Astro.props;
const { title, date, tag, excerpt, cover } = news.data;
const dateISO = date.toISOString().slice(0, 10);
---

<article class="card news-card" data-od-id={odId}>
  <div class="news-cover"><NewsIcon name={cover ?? 'megaphone'} /></div>
  <span class="card-meta"><time datetime={dateISO}>{formatDate(dateISO)}</time><span class={`tag ${TAG_CLASS_MAP[tag]}`}>{tag}</span></span>
  <h3><a href={href}>{title}</a></h3>
  <p>{excerpt}</p>
  <a class="card-arrow" href={href}>Читать далее →</a>
</article>
